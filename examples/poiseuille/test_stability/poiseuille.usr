      subroutine userchk

      use stdlib_io_npy
      use neklab
      use neklab_nek_setup, only: nek_log_message
      implicit none
      include "SIZE"
      include "TOTAL"

      ! input/output
      integer, parameter :: ntotv = lx1*ly1*lz1*lelv
      integer, parameter :: ntotp = lx2*ly2*lz2*lelv
      type(nek_dvector), allocatable :: bf, test_in, test_out
      type(exptA_proj_linop) :: exptA
      integer, parameter :: kdim = 512, nev = 20
      real(dp) :: alpha, beta
      character(len=128) :: msg
      real(dp), allocatable :: eig(:, :)
      type(nek_dvector), allocatable :: eigvecs(:)
      complex(dp), allocatable :: eigvals(:)
      real(dp), allocatable :: residuals(:)
      integer :: i, n, info
      character(len=3) :: file_prefix
      
      real :: glsc3
      
      if (istep.eq.0) then
            call outpost(vx, vy, vz, pr, t, 'bf_')
	    allocate(bf); call bf%init()
            call nek2vec(bf, vx, vy, vz, pr, t)
            ! Exponential propagator.
            exptA = exptA_proj_linop(1.0_dp, bf, 1.0_dp) ; call exptA%init()

            ! Stability analysis.
            call linear_stability_analysis_fixed_point(exptA, kdim, nev)

	    ! load eigenvectors and check that they are normalized and outposted using correct scaling
            ifield = 1
            n = nx1*ny1*nz1*nelv
            call load_fld("dirpoiseuille0.f00001")
            call nek2vec(bf, vx, vy, vz, pr, t)
            alpha = sqrt(glsc3(vx, vx, bm1, n) + glsc3(vy, vy, bm1, n))
            write(msg,'(2(A,F16.12))') 'alpha: (nek) ', alpha, ' (LK) ',bf%norm()
	    call nek_log_message(msg, procedure='userchk')
	    call load_fld("dirpoiseuille0.f00002")
            call nek2vec(bf, vx, vy, vz, pr, t)
            beta = sqrt(glsc3(vx, vx, bm1, n) + glsc3(vy, vy, bm1, n))
            write(msg,'(2(A,F16.12))') 'beta:  (nek) ', beta, ' (LK) ', bf%norm()
	    call nek_log_message(msg, procedure='userchk')
            write(msg,'(A,F16.12)') 'norm:        ', sqrt(alpha**2 + beta**2)
	    call nek_log_message(msg, procedure='userchk')
      end if
      return
      end
