      subroutine userchk

      use neklab
      use LightKrylov, only: innerprod, zero_basis
      use LightKrylov_BaseKrylov, only: double_gram_schmidt_step
      use stdlib_linalg, only: eig, svdvals
      use stdlib_math, only: logspace
      implicit none
      include "SIZE"
      include "TOTAL"

      ! baseflow
      type(nek_dvector), allocatable :: bf
      ! input/output
      type(nek_dvector), allocatable :: input(:)
      type(nek_dvector), allocatable :: output(:)
      ! system matrix and exponential propagator
      type(exptA_proj_linop), allocatable :: exptA
      ! time
      real(dp) :: Tend, tau, norm, norm_old, energy, energy_old, alpha
      integer  :: i, nsub, info
      
      if (istep.eq.0) then
         
         ! Load baseflow into LK
	 allocate(bf); call bf%init()
    	 call nek2vec(bf, vx, vy, vz, pr, t)

         ! Define inputs
	 allocate(input(1)); call input(1)%init()
         call make_actuator(input)

         Tend = 0.2_dp
         tau = 0.1_dp
         nsub = nint(Tend/tau)
         allocate(output(nsub)); 
	 do i = 1, nsub
	    call output(i)%init()
	 end do
	 !call zero_basis(output)

         ! Define exponential propagator
         exptA = exptA_proj_linop(tau, bf, 1.0_dp); call exptA%init()
      
         exptA%tau = Tend
         call make_actuator(input)
	   norm = input(1)%norm();
         call input(1)%scal(1.0/norm);
         call outpost_dnek(input(1), 'ini')
         energy_old = norm

         call exptA%matvec(input(1), output(1))
         call outpost_dnek(output(1), 'out')
         norm_old = output(1)%norm(); energy_old = energy_old*norm_old
	   if (nid == 0) print *, 'Step', 1, 'norm', norm_old, 'energy1', energy_old
         call output(1)%scal(1.0/norm_old)

         exptA%tau = tau
         call make_actuator(input)
	   norm = input(1)%norm(); call input(1)%scal(1.0/norm); call outpost_dnek(input(1), 'ini')
         energy = norm
         do i = 1, nsub
            norm_old = norm
            call exptA%matvec(input(1), output(i))
            call outpost_dnek(output(i), 'out')
	      norm = output(i)%norm(); energy = energy*norm
	      if (nid == 0) print *, 'Step', i, 'norm', norm, 'energy2', energy
            call output(i)%scal(1.0/norm)
            input(1) = output(i)
         end do
         if (nid == 0) print *, 'norm_dif', norm-norm_old, 'energy_dif',energy-energy_old
         call nek_end()
      end if
      return
      end
