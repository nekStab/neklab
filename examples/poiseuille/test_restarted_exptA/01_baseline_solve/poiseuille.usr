      subroutine userchk

      use neklab
      implicit none
      include "SIZE"
      include "TOTAL"

      ! baseflow
      type(nek_dvector), allocatable :: pert
      real(dp) :: nrm
      character(len=128) :: fname
      
      if (istep.eq.0) then
            write(fname,'(A,I5.5)') 'ic_poiseuille0.f', 1
            call load_fld(fname)
	    allocate(pert); call pert%init()
            call nek2vec(pert, vx, vy, vz, pr, t)
            call blank(initc(1),132)
            call setics()
            call vec2nek(vxp, vyp, vzp, prp, tp, pert)
	    time = 0.0_dp
	    call pert%zero()
            nrm = pert%norm()
            if (nid == 0) print *, 'Step', istep, 'time',time, 'norm',nrm
      else
            call nek2vec(pert,vxp,vyp,vzp,prp,tp)
            call outpost_dnek(pert,'prt')
            nrm = pert%norm()
            if (nid == 0) print *, 'Step', istep, 'time',time, 'norm',nrm
      end if
      return
      end
