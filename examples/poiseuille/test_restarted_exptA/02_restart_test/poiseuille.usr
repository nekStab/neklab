      subroutine userchk

      use LightKrylov
      use neklab
      use neklab_nek_setup
      implicit none
      include "SIZE"
      include "TOTAL"
      
      integer, parameter :: nsnap = 10
      integer, parameter :: nvec = 5
      ! vectors
      type(nek_dvector), allocatable :: bf, pert, vec_rst
      type(nek_dvector), allocatable :: reference(:), test(:)
      type(nek_dvector), allocatable :: basis_ref(:), basis(:)
      type(nek_dvector), allocatable :: p1, rst1(:), p2, rst2(:), tmp
      type(nek_dvector), allocatable :: p_in, p_out
      ! exponential propagator
      type(exptA_linop), allocatable :: exptA
      real(dp) :: norm, alpha, IP(nvec,nvec)
      real(dp), allocatable :: G(:,:), beta(:)
      integer :: i, j, irst, ivec, info
      character(len=128) :: fname, msg

      integer, parameter :: lv = lx1*ly1*lz1*lelv
      integer, parameter :: lp = lx2*ly2*lz2*lelv

      real(dp), dimension(lv, lorder-1) :: vxr, vyr, vzr
      real(dp), dimension(lp, lorder-1) :: prr
      real(dp), dimension(lv,3) :: vx1, vy1, vz1
      real(dp), dimension(lv,3) :: vx2, vy2, vz2
      real(dp), dimension(lp,3) :: pr1, pr2
      real(dp), dimension(lv, lorder-1) :: vxr_ref, vyr_ref, vzr_ref

      real(dp), external :: pert_inner_prod, glsc3

      real(dp) :: pran, ray, rayc
      common/normset/pran, ray, rayc

      pran = 1.0_dp
      ray  = 1.0_dp
      rayc = 1.0_dp

      if (istep.eq.0) then
         ! read reference solution
	 allocate(reference(nsnap))
	 do i = 1, nsnap
	    call reference(i)%init()
	 end do
         !call zero_basis(reference)
         do i = 1, nsnap
            write(fname,'(A,I5.5)') 'prtpoiseuille0.f', i
            call load_fld(fname) ; call nek2vec(reference(i), vx,vy,vz,pr,t)
         end do
         ! load initial condition
         write(fname,'(A,I5.5)') 'ic_poiseuille0.f', 1
         call load_fld(fname)
	 allocate(pert); call pert%init()
	 call nek2vec(pert, vx, vy, vz, pr, t)
         ! reset baseflow
         call blank(initc(1),132) ; call setics()
	 allocate(bf); call bf%init()
	 call nek2vec(bf,vx,vy,vz,pr,t)

         allocate(p1); call p1%init()
         p1      = pert
	 allocate(rst1(2))
	 do i = 1, 2
	    call rst1(i)%init()
            rst1(i) = reference(i)
	 end do
         !rst1(1) = reference(1)
         !rst1(2) = reference(2)

