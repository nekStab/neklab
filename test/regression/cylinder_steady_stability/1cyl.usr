c-----------------------------------------------------------------------
c     REGRESSION -- 2D cylinder, Stability analysis of the steady base flow
c
c     full: from noise converge 2 modes
c     fast: from initial guess converge 1 mode
c-----------------------------------------------------------------------
      include 'neklab_test_helpers.f'
c-----------------------------------------------------------------------
      subroutine userchk
      use neklab
      use neklab_test_helpers
      implicit none
      include "SIZE"
      include "TOTAL"

      ! Linear operator
      type(exptA_linop), allocatable :: exptA
      ! State vectors
      type(nek_dvector), allocatable :: bf, x0, amp, amp_ref
      ! Eigenvectors
      type(nek_dvector), allocatable :: eigvecs(:)
      complex(dp), allocatable :: eigvals(:)
      real(dp), allocatable :: residuals(:)
      integer :: info, imode, i, nv
      logical :: ok, if_adjoint, have_re, have_im
      character(len=3) :: fpfx
      character(len=128) :: key, ref_fld, fre, fim
      
c     ---- Settings -----------------------------------------------------
      integer  :: kdim = 128
      integer  :: nev  = 2          ! full: 4
      logical  :: load_x0 = .true.  ! full: .false.
c     -------------------------------------------------------------------

      if (istep.eq.0) then
         call log_section('eigs test settings')
         call log_setting('kdim', kdim)
         call log_setting('nev', nev)
         call log_setting('load_x0', load_x0)

         allocate(bf, x0, amp, amp_ref, eigvecs(nev))
         
         ! Load baseflow
         call load_fld('BF.fld U P T')
         call nek2vec(bf, vx, vy, vz, pr, t)

         ! Exponential propagator.
         exptA = exptA_linop(tau=1.0_dp, baseflow=bf)
         call exptA%init()

         do imode = 1, 2
            fpfx        = merge('dir',    'adj',    imode==1)
            ref_fld     = merge('x0.fld', 'y0.fld', imode==1)
            if_adjoint  = (imode == 2)
            key = '---- eigs: '//fpfx//' ----'
            call nek_log_message(key, procedure='main')

            call zero_basis(eigvecs)

            ! Stability analysis.
            if (load_x0) then
               ! Load initial guess
               call load_fld(trim(ref_fld)//' U P T')
               call nek2vec(x0, vx, vy, vz, pr, t)
               call eigs(exptA, eigvecs, eigvals, residuals, info, 
     &                  kdim=kdim, write_intermediate=.true., 
     &                  transpose = if_adjoint, x0=x0)
            else
               call eigs(exptA, eigvecs, eigvals, residuals, info, 
     &                  kdim=kdim, write_intermediate=.true., 
     &                  transpose = if_adjoint)
            end if

            ! Transform eigenspectrum to continuous-time representation.
            eigvals = log(eigvals)/exptA%tau

            ! Export eigenfunctions to disk.
            call outpost_nek(eigvecs(:nev), fpfx)
            ! rename eigs
            if (nid == 0) call rename('eigs_output.txt', fpfx//'_eigs_output.txt')

            ! eigenvalue
            do i = 1, nev
               write(key, '(2A,I0,A)') fpfx, '_lambda_', i, '_re'
               call report(key, real(eigvals(i), dp))
               write(key, '(2A,I0,A)') fpfx, '_lambda_', i, '_im'
               call report(key, aimag(eigvals(i)))
               write(key, '(2A,I0,A)') fpfx, '_mode_', i, '_residual'
               call report(key, residuals(i))
            end do
            ! amplitude error against the reference mode, if provided
            write(fre, '(2A,I0,A)') 'ref_', fpfx, 1, '_re.fld'
            write(fim, '(2A,I0,A)') 'ref_', fpfx, 1, '_im.fld'
            inquire(file=trim(fre), exist=have_re)
            inquire(file=trim(fim), exist=have_im)
            if (have_re .and. have_im) then
               nv = lx1*ly1*lz1*nelv
               call amp%zero(); call amp_ref%zero()
               call load_fld(trim(fre)//' U P T')
               call nek2vec(x0, vx, vy, vz, pr, t)
               call load_fld(trim(fim)//' U P T')
               call nek2vec(amp, vx, vy, vz, pr, t)
               associate(re => x0, im => amp)
                  amp_ref%vx = sqrt(re%vx**2 + im%vx**2)
                  amp_ref%vy = sqrt(re%vy**2 + im%vy**2)
                  amp_ref%vz = sqrt(re%vz**2 + im%vz**2)
               end associate
               call amp%zero()
               associate(re => eigvecs(1), im => eigvecs(2))
                  amp%vx = sqrt(re%vx**2 + im%vx**2)
                  amp%vy = sqrt(re%vy**2 + im%vy**2)
                  amp%vz = sqrt(re%vz**2 + im%vz**2)
               end associate
               call amp%sub(amp_ref)
               write(key, '(2A,I0,A)') fpfx, '_mode_amp_err'
               call report(key, amp%norm())
            end if
         end do

         call tests_completed()
      end if

      return
      end
c----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux=1.0d0
         uy=0.0d0
         uz=0.0d0
         temp=0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp=0.0d0

      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff = 0.0d0
      utrans = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine userq (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use LightKrylov_Logger
      include 'SIZE'
      include 'TOTAL'

      ! Setup logger
      call logger_setup(nio=0, log_level=lk_information_level, log_stdout=.false., log_timestamp=.true.)
      
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end