[GENERAL]
startFrom = 0
stopAt = endtime
endTime = 1.0

dt = 0.009
variableDt = no
timeStepper = bdf3
targetCFL = 0.5

writeControl = runTime
writeInterval = 20
writeDoublePrecision = yes

dealiasing = yes

[PROBLEMTYPE]
equation = incompNS

[PRESSURE]
preconditioner = semg_xxt
residualTol = 1.0E-8
residualProj = yes
writeToFieldFile = yes

[VELOCITY]
residualTol = 1.0E-10
residualProj = yes
density = 1.0
viscosity = -50.0
