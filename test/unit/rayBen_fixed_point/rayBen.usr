c-----------------------------------------------------------------------
c     UNIT TEST -- Rayleigh-Benard convection, fixed point (with temperature)
c
c     nek_dvector with temperature, exptA_temp_linop,
c     nek_temp_system + nek_temp_jacobian, on the conduction state
c     u = 0, T = 1 - y (built below).
c
c     Settings: the initialised variables at the top of userchk. The test
c     harness (suites/unit/rayben.py) edits them in its scratch copy.
c-----------------------------------------------------------------------
      include 'neklab_test_helpers.f'
c-----------------------------------------------------------------------
      subroutine userchk
      use LightKrylov
      use neklab
      use neklab_test_helpers
      implicit none
      include 'SIZE'
      include 'TOTAL'
      include 'ADJOINT'

c     ---- Settings -----------------------------------------------------
      logical  :: test_zero_map    = .true.     ! test zero invariant map
      logical  :: test_adjoint     = .true.     ! test adjoint compatibility
      logical  :: verb             = .true.     ! verbose output
      real(dp) :: tau              = 0.1_dp     ! integration time of exptA
      real(dp) :: cfl_limit        = 0.4_dp
      real(dp) :: ptol             = 1.0e-08_dp ! pressure tolerance
      real(dp) :: p2v_factor       = 0.01_dp    ! vtol = ptol*p2v_factor
      integer  :: ntrials_vec      = 10         ! vector axioms (cheap)
      integer  :: ntrials_lin      = 2          ! operator axioms (time integrations)
      real(dp) :: vec_tol          = 1.0e-10_dp ! vector axioms
      real(dp) :: lin_tol          = 1.0e-06_dp ! operator axioms (100*ptol)
      real(dp) :: adj_tol          = 1.0e-2_dp  ! operator axioms
      real(dp) :: eps0             = 1.0_dp     ! initial perturbation for Taylor test
      real(dp) :: taylor_tol       = 1.0e-8_dp  ! solver atol in the Taylor test
      real(dp) :: taylor_min_order = 1.8_dp
c     -------------------------------------------------------------------

      type(nek_dvector),      allocatable :: dvec, bf
      type(exptA_temp_linop), allocatable :: exptA
      type(nek_temp_system),  allocatable :: sys
      real(dp), allocatable :: orders(:)
      real(dp) :: maxerr(4)
      logical  :: ok
      integer  :: i
      character(len=128) :: this_test
      integer, parameter :: lv = lx1*ly1*lz1*lelv
      integer, parameter :: lp = lx2*ly2*lz2*lelv

c     ---- what this run uses, in the log
      call log_section('unit test settings (rayBen_fixed_point)')
      call log_setting('test_zero_map', test_zero_map)
      call log_setting('test_adjoint', test_adjoint)
      call log_setting('verb', verb)
      call log_setting('tau', tau)
      call log_setting('cfl_limit', cfl_limit)
      call log_setting('ptol', ptol)
      call log_setting('p2v_factor', p2v_factor)
      call log_setting('ntrials_vec', ntrials_vec)
      call log_setting('ntrials_lin', ntrials_lin)
      call log_setting('vec_tol', vec_tol)
      call log_setting('lin_tol', lin_tol)
      call log_setting('adj_tol', adj_tol)
      call log_setting('eps0', eps0)
      call log_setting('taylor_tol', taylor_tol)
      call log_setting('taylor_min_order', taylor_min_order)

      allocate(dvec, bf)

      ! ---- base flow (analytical conduction state)
      call rzero(vx, lv)
      call rzero(vy, lv)
      call rzero(vz, lv)
      call rzero(pr, lp)
      do i = 1, lv
         t(i,1,1,1,1) = 1.0_dp - ym1(i,1,1,1)
      end do
      call nek2vec(bf, vx, vy, vz, pr, t)

      ! reset baseflow temperature gradient for adjoint computation
      if (test_adjoint) call gradm1(dTdx,dTdy,dTdz,t)

      ! ---- nek_dvector (with temperature)
      this_test = 'nek_dvector_temp.axioms'
      call dvec%zero()
      ok = verify_vector_axioms(dvec,
     &                      ntrials          = ntrials_vec,
     &                      tolerance        = vec_tol,
     &                      verbose          = verb)
      call check(this_test, ok)

      ! ---- exponential propagator with temperature
      exptA = exptA_temp_linop(tau = tau, baseflow = bf)
      call exptA%init(cfl_limit              = cfl_limit, 
     &                     ptol              = ptol, 
     &                     p2v_factor        = p2v_factor, 
     &                     recompute_dt      = .false.)

      this_test = 'exptA_temp_linop.axioms'
      ok = verify_linop_axioms(exptA, bf,
     &                      ntrials          = ntrials_lin,
     &                      tolerance        = lin_tol,
     &                      adj_tolerance    = adj_tol,
     &                      test_zero_map    = test_zero_map,
     &                      test_adjoint     = test_adjoint,
     &                      verbose          = verb,
     &                      stop_on_failure  = .false.,
     &                      max_errors       = maxerr)
      call check_linop(this_test, ok, maxerr, test_adjoint, lin_tol, adj_tol)

      ! ---- nek_temp_system (integration time = endTime of the .par)
      sys = nek_temp_system()
      sys%jacobian = nek_temp_jacobian()
      sys%jacobian%X = bf
      call sys%init(cfl_limit                = cfl_limit, 
     &                      p2v_factor       = p2v_factor,,
     &                      newton_tol_factor= 0.1_dp, 
     &                      recompute_dt     = .false.)

      this_test = 'nek_temp_system.linearization'
      call verify_system_linearization(sys,
     &                      nsteps           = 6,
     &                      eps0             = eps0,
     &                      stepratio        = sqrt(0.1_dp),
     &                      tolerance        = taylor_tol,
     &                      verbose          = verb,
     &                      orders           = orders)
      call check_taylor(this_test, orders, taylor_min_order)

      this_test = 'nek_temp_system%jacobian.axioms'
      ok = verify_linop_axioms(sys%jacobian, bf,
     &                      ntrials          = ntrials_lin,
     &                      tolerance        = lin_tol,
     &                      adj_tolerance    = adj_tol,
     &                      test_zero_map    = test_zero_map,
     &                      test_adjoint     = test_adjoint,
     &                      verbose          = verb,
     &                      stop_on_failure  = .false.,
     &                      max_errors       = maxerr)
      call check_linop(this_test, ok, maxerr, test_adjoint, lin_tol, adj_tol)

      call tests_completed()
      end
c-----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      use neklab, only: neklab_forcing
      implicit none
      include 'SIZE'
      include 'SOLN'            ! jp
      include 'NEKUSE'          ! FFX, FFY, FFZ
      include 'PARALLEL'        ! GLLEL
      include 'ADJOINT'         ! ifadj

      integer ix,iy,iz,ieg,ijke,iel
      real rapr

      common /rayleigh_r/ rapr
 
      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

      iel = gllel(ieg)
      ijke = ix + nx1*(iy-1+ny1*(iz-1+nz1*(iel-1)))
      if (jp == 0) then
      	ffy = temp*rapr               ! base flow
      else if (.not. ifadj) then
         ffy = tp(ijke, 1, 1)*rapr     ! direct: Ra * Pr * T'   
      end if
      
      call neklab_forcing(FFX,FFY,FFZ,ix,iy,iz,ieg,jp)

      end
c-----------------------------------------------------------------------
      subroutine userq (ix,iy,iz,ieg)
      implicit none
      include 'SIZE'
      include 'SOLN'            ! jp, vyp
      include 'NEKUSE'          ! qvol
      include 'PARALLEL'        ! GLLEL
      include 'ADJOINT'         ! ifadj
      integer ix,iy,iz,ieg,ijke,iel
      real rapr
      common /rayleigh_r/ rapr
      qvol = 0.0d0
      avol = 0.0d0
      if (jp > 0 .and. ifadj) then
         iel  = gllel(ieg)
         ijke = ix + nx1*(iy-1+ny1*(iz-1+nz1*(iel-1)))
         qvol = rapr*vyp(ijke,1)       ! adjoint: Ra Pr v_y^+
      end if
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TSTEP'
      include 'INPUT'
      include 'NEKUSE'
      include 'SOLN'            ! jp
      if (JP.eq.0) then         ! velocity
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp= 1.0d0 - y
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      if (JP.eq.0) then         ! velocity
         ux= 0.0d0
         uy= 0.0d0
         uz= 0.0d0
         temp= 1.0d0 - y
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      end
c-----------------------------------------------------------------------
      subroutine usrdat
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use LightKrylov_Logger
      include 'SIZE'
      include 'TOTAL'
      common /rayleigh_r/ rapr
      Prandtl  = uparam(5)
      Rayleigh  = uparam(6)
      param(2) = sqrt(Prandtl/Rayleigh)
      param(8) = 1.0d0/sqrt(Prandtl*Rayleigh)
      rapr = Rayleigh*Prandtl
      
      call logger_setup(nio=0, log_level=lk_information_level, log_stdout=.true., log_timestamp=.true.)

      end
