c-----------------------------------------------------------------------
c     UNIT TEST -- 2D cylinder, fixed point
c
c     nek_dvector, nek_zvector, exptA_linop, nek_system + nek_jacobian,
c     on the steady base flow BF.fld.
c
c     Settings: the initialised variables at the top of userchk. The test
c     harness (suites/unit/cylinder.py) edits them in its scratch copy.
c-----------------------------------------------------------------------
      include 'neklab_test_helpers.f'
c-----------------------------------------------------------------------
      subroutine userchk
      use LightKrylov
      use neklab
      use neklab_test_helpers
      implicit none
      include 'SIZE'
      include 'TOTAL'

c     ---- Settings -----------------------------------------------------
      character(len=128) :: base_flow = 'BF.fld'
      logical  :: test_zero_map    = .true.     ! test zero invariant map
      logical  :: test_adjoint     = .true.     ! test adjoint compatibility
      logical  :: verb             = .true.     ! verbose output
      real(dp) :: tau              = 0.1_dp     ! integration time of exptA
      real(dp) :: cfl_limit        = 0.4_dp
      real(dp) :: ptol             = 1.0e-08_dp ! pressure tolerance
      real(dp) :: p2v_factor       = 0.01_dp    ! vtol = ptol*p2v_factor
      integer  :: ntrials_vec      = 10         ! vector axioms (cheap)
      integer  :: ntrials_lin      = 2          ! operator axioms (time integrations)
      real(dp) :: vec_tol          = 1.0e-11_dp ! vector axioms
      real(dp) :: lin_tol          = 1.0e-06_dp ! operator axioms (100*ptol)
      real(dp) :: adj_tol          = 1.0e-2_dp  ! operator axioms
      real(dp) :: eps0             = 1.0_dp     ! initial perturbation for Taylor test
      real(dp) :: taylor_tol       = 1.0e-8_dp  ! solver atol in the Taylor test
      real(dp) :: taylor_min_order = 1.8_dp
c     -------------------------------------------------------------------

      type(nek_dvector), allocatable :: dvec, bf
      type(nek_zvector), allocatable :: zvec
      type(exptA_linop), allocatable :: exptA
      type(nek_system),  allocatable :: sys
      real(dp), allocatable :: orders(:)
      real(dp) :: maxerr(4)
      logical  :: ok
      character(len=128) :: this_test

c     ---- what this run uses, in the log
      call log_section('unit test settings (cylinder_fixed_point)')
      call log_setting('base_flow', base_flow)
      call log_setting('test_zero_map', test_zero_map)
      call log_setting('test_adjoint', test_adjoint)
      call log_setting('verb', verb)
      call log_setting('tau', tau)
      call log_setting('cfl_limit', cfl_limit)
      call log_setting('ptol', ptol)
      call log_setting('p2v_factor', p2v_factor)
      call log_setting('ntrials_vec', ntrials_vec)
      call log_setting('ntrials_lin', ntrials_lin)
      call log_setting('vec_tol', vec_tol)
      call log_setting('lin_tol', lin_tol)
      call log_setting('adj_tol', adj_tol)
      call log_setting('eps0', eps0)
      call log_setting('taylor_tol', taylor_tol)
      call log_setting('taylor_min_order', taylor_min_order)

      allocate(dvec, zvec, bf)

      ! ---- base flow
      call load_fld(trim(base_flow))
      call nek2vec(bf, vx, vy, vz, pr, t)

      ! ---- nek_dvector
      this_test = 'nek_dvector.axioms'
      call dvec%zero()
      ok = verify_vector_axioms(dvec,
     &                      ntrials          = ntrials_vec,
     &                      tolerance        = vec_tol,
     &                      verbose          = verb)
      call check(this_test, ok)

      ! ---- nek_zvector
      this_test = 'nek_zvector.axioms'
      call zvec%zero()
      ok = verify_vector_axioms(zvec,
     &                      ntrials          = ntrials_vec,
     &                      tolerance        = vec_tol,
     &                      verbose          = verb)
      call check(this_test, ok)

      ! ---- exponential propagator
      exptA = exptA_linop(tau = tau, baseflow = bf)
      call exptA%init(cfl_limit=cfl_limit, ptol=ptol, p2v_factor=p2v_factor)

      this_test = 'exptA_linop.axioms'
      ok = verify_linop_axioms(exptA, bf,
     &                      ntrials          = ntrials_lin,
     &                      tolerance        = lin_tol,
     &                      adj_tolerance    = adj_tol,
     &                      test_zero_map    = test_zero_map,
     &                      test_adjoint     = test_adjoint,
     &                      verbose          = verb,
     &                      stop_on_failure  = .false.,
     &                      max_errors       = maxerr)
      call check_linop(this_test, ok, maxerr, test_adjoint, lin_tol, adj_tol)

      ! ---- nek_system (integration time = endTime of the .par)
      sys = nek_system()
      sys%jacobian = nek_jacobian()
      sys%jacobian%X = bf
      call sys%init(cfl_limit=cfl_limit, p2v_factor=p2v_factor, newton_tol_factor=0.1_dp)

      this_test = 'nek_system.linearization'
      call verify_system_linearization(sys,
     &                      nsteps           = 6,
     &                      eps0             = eps0,
     &                      stepratio        = sqrt(0.1_dp),
     &                      tolerance        = taylor_tol,
     &                      verbose          = verb,
     &                      orders           = orders)
      call check_taylor(this_test, orders, taylor_min_order)

      this_test = 'nek_system%jacobian.axioms'
      ok = verify_linop_axioms(sys%jacobian, bf,
     &                      ntrials          = ntrials_lin,
     &                      tolerance        = lin_tol,
     &                      adj_tolerance    = adj_tol,
     &                      test_zero_map    = test_zero_map,
     &                      test_adjoint     = test_adjoint,
     &                      verbose          = verb,
     &                      stop_on_failure  = .false.,
     &                      max_errors       = maxerr)
      call check_linop(this_test, ok, maxerr, test_adjoint, lin_tol, adj_tol)

      call tests_completed()
      end
c----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux=1.0d0
         uy=0.0d0
         uz=0.0d0
         temp=0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp=0.0d0

      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff = 0.0d0
      utrans = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine userq (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use LightKrylov_Logger
      include 'SIZE'
      include 'TOTAL'
      integer iel,ifc

      call logger_setup(nio=0, log_level=lk_information_level, log_stdout=.true., log_timestamp=.true.)

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
