c-----------------------------------------------------------------------
c     UNIT TESTS -- 2D cylinder
c
c     Checks nek_dvector, nek_zvector, exptA_linop and nek_system (with its
c     Jacobian) against the contracts of LightKrylov.
c
c        1  fixed point   nek_dvector, nek_zvector, exptA_linop,
c                         nek_system + nek_jacobian               on BF.fld
c        2  resolvent     resolvent_linop                         on BF.fld
c        3  periodic orbit  nek_ext_dvector,
c                         nek_upo_system + nek_upo_jacobian       on snapshot.fld
c
c-----------------------------------------------------------------------
      subroutine userchk
      use LightKrylov
      use neklab
      implicit none
      include 'SIZE'
      include 'TOTAL'

c     ---- Settings -----------------------------------------------------
      character(len=*), parameter :: base_flow = 'BF.fld'   ! base flow file
      character(len=*), parameter :: snapshot  = 'snapshot.fld' ! snapshot file
      real(dp), parameter :: tau               = 0.1_dp     ! integration time of exptA
      real(dp), parameter :: omega             = 8.0_dp*atan(1.0_dp)/0.1_dp     ! frequency
      real(dp), parameter :: period            = 0.1_dp     ! guessed period
      real(dp), parameter :: cfl_limit         = 0.4_dp
      real(dp), parameter :: ptol              = 1.0e-08_dp ! pressure tolerance
      real(dp), parameter :: p2v_factor        = 0.01_dp    ! vtol = ptol*p2v_factor
      integer,  parameter :: ntrials_vec       = 10         ! vector axioms (cheap)
      integer,  parameter :: ntrials_lin       = 2          ! operator axioms (time integrations)
      real(dp), parameter :: vec_tol           = 1.0e-11_dp ! vector axioms
      real(dp), parameter :: lin_tol           = 100*ptol   ! operator axioms
      real(dp), parameter :: lin_tol_res       = 1.0e-4_dp  ! resolvent (GMRES tol.)
      real(dp), parameter :: adj_tol           = 1.0e-2_dp  ! operator axioms
      real(dp), parameter :: eps0              = 1.0_dp     ! initial perturbation for Taylor test
      real(dp), parameter :: taylor_min_order  = 1.8_dp
      logical,  parameter :: verb              = .true.     ! verbose output for vector axioms
c     -------------------------------------------------------------------

      ! vector types
      type(nek_dvector),     allocatable :: dvec, bf
      type(nek_zvector),     allocatable :: zvec
      type(nek_ext_dvector), allocatable :: evec, x0
      ! linop types
      type(exptA_linop),     allocatable :: exptA
      type(resolvent_linop), allocatable :: resolvent
      ! system types
      type(nek_system),      allocatable :: sys
      type(nek_upo_system),  allocatable :: sys_upo
      ! miscellaneous
      real(dp), allocatable :: orders(:)
      real(dp) :: maxerr(4)
      logical  :: ok
      character(len=128) :: this_test

      select case (nint(uparam(2)))
      case (1)                         ! fixed point

         allocate(dvec, zvec, bf)

         ! Base flow
         call load_fld(base_flow)
         call nek2vec(bf, vx, vy, vz, pr, t)

         !----------------------------
         !
         ! NEK REAL VECTOR TYPE
         !
         !----------------------------
         this_test = 'nek_dvector.axioms'
         call dvec%zero()
         ok = verify_vector_axioms(dvec, ntrials=ntrials_vec, tolerance=vec_tol, verbose=verb)
         call check(this_test, ok)

         !----------------------------
         !
         ! NEK COMPLEX VECTOR TYPE
         !
         !----------------------------
         this_test = 'nek_zvector.axioms'
         call zvec%zero()
         ok = verify_vector_axioms(zvec, ntrials=ntrials_vec, tolerance=vec_tol, verbose=verb)
         call check(this_test,ok)

         !----------------------------
         !
         ! EXPONENTIAL PROPAGATOR
         !
         !----------------------------
         exptA = exptA_linop(tau = tau, baseflow = bf)
         call exptA%init(cfl_limit=cfl_limit, ptol=ptol, p2v_factor=p2v_factor)

         this_test = 'exptA_linop.axioms'
         ok = verify_linop_axioms(exptA, bf, 
     &                         ntrials          = ntrials_lin,
     &                         tolerance        = lin_tol, 
     &                         adj_tolerance    = adj_tol, 
     &                         test_zero_map    = .true.,
     &                         test_adjoint     = .true., 
     &                         verbose          = verb,
     &                         stop_on_failure  = .false., 
     &                         max_errors       = maxerr)
         call check_linop(this_test, ok, maxerr, .true.,  lin_tol, adj_tol)

         !----------------------------
         !
         ! NEK SYSTEM
         !
         !----------------------------
         sys = nek_system()
         sys%jacobian = nek_jacobian()
         sys%jacobian%X = bf
         call sys%init(cfl_limit=cfl_limit, p2v_factor=p2v_factor, newton_tol_factor=0.1_dp)

         this_test = 'nek_system.linarization'
         call verify_system_linearization(sys, 
     &                         nsteps           = 6,
     &                         eps0             = eps0,
     &                         stepratio        = sqrt(0.1_dp),
     &                         tolerance        = 1.0e-8_dp,
     &                         verbose          = verb,
     &                         orders           = orders)
         call check_taylor(this_test, orders)

         this_test = 'nek_system%jacobian.axioms'
         ok = verify_linop_axioms(sys%jacobian, bf, 
     &                         ntrials          = ntrials_lin,
     &                         tolerance        = lin_tol,
     &                         adj_tolerance    = adj_tol,  
     &                         test_zero_map    = .true.,
     &                         test_adjoint     = .true., 
     &                         verbose          = verb,
     &                         stop_on_failure  = .false., 
     &                         max_errors       = maxerr)
         call check_linop(this_test, ok, maxerr, .true.,  lin_tol, adj_tol)

      case (2)                         ! resolvent

         allocate(bf, zvec)

         ! Base flow
         call load_fld(base_flow)
         call nek2vec(bf, vx, vy, vz, pr, t)

         !----------------------------
         !
         ! NEK COMPLEX VECTOR TYPE
         !
         !----------------------------
         this_test = 'nek_zvector.axioms'
         call zvec%zero()
         ok = verify_vector_axioms(zvec, ntrials=ntrials_vec, tolerance=vec_tol, verbose=verb)
         call check(this_test,ok)

         !----------------------------
         !
         ! RESOLVENT OPERATOR
         !
         !----------------------------
         resolvent = resolvent_linop(omega=omega, baseflow=bf)
         call resolvent%init(bf=bf, omega=omega, cfl_limit=cfl_limit, ptol=ptol, p2v_factor=p2v_factor)

         this_test = 'resolvent_linop.axioms'
         ok = verify_linop_axioms(resolvent, zvec, 
     &                         ntrials          = 1,
     &                         tolerance        = lin_tol_res, 
     &                         adj_tolerance    = adj_tol, 
     &                         test_zero_map    = .true.,
     &                         test_adjoint     = .true., 
     &                         verbose          = verb,
     &                         stop_on_failure  = .false., 
     &                         max_errors       = maxerr)
         call check_linop(this_test, ok, maxerr, .true., lin_tol_res, adj_tol)


      case (3)                         ! periodic orbit

         allocate(x0, evec)

         ! Base flow
         call load_fld(snapshot)
         call nek2ext_vec(x0, vx, vy, vz, pr, t)
         x0%T = period  ! guesses period
         
         this_test = 'nek_ext_dvector.axioms'
         call evec%zero()
         ok = verify_vector_axioms(evec, ntrials=ntrials_vec, tolerance=vec_tol, verbose=verb)
         call check(this_test,ok)

         !----------------------------
         !
         ! NEK UPO SYSTEM
         !
         !----------------------------
         sys_upo = nek_upo_system()
         sys_upo%jacobian = nek_upo_jacobian()
         sys_upo%jacobian%X = x0
         call sys_upo%init(cfl_limit=cfl_limit, p2v_factor=p2v_factor, newton_tol_factor=0.1_dp)

         this_test = 'nek_upo_system.linarization'
         call verify_system_linearization(sys_upo, 
     &                         nsteps           = 6,
     &                         eps0             = eps0, 
     &                         stepratio        = sqrt(0.1_dp),
     &                         tolerance        = 1e-8_dp, 
     &                         verbose          = verb, 
     &                         orders           = orders)
         call check_taylor(this_test, orders)

         this_test = 'nek_upo_system%jacobian.axioms'
         ok = verify_linop_axioms(sys_upo%jacobian, x0, 
     &                         ntrials          = ntrials_lin,
     &                         tolerance        = lin_tol, 
     &                         adj_tolerance    = adj_tol, 
     &                         test_zero_map    = .true.,
     &                         test_adjoint     = .true., 
     &                         verbose          = verb,
     &                         stop_on_failure  = .false., 
     &                         max_errors       = maxerr)
         call check_linop(this_test, ok, maxerr, .true., lin_tol, adj_tol)

      case default
         call check('setup.group', .false., info='set userParam2 = 1, 2 or 3 in the .par')
      end select

      call nek_log_message('############################', procedure='main')
      call nek_log_message('#     tests completed      #', procedure='main')
      call nek_log_message('############################', procedure='main')


      call nek_end()

      contains

      subroutine check(name, ok, tol, info)
      use stdlib_strings, only : padr
      character(len=*), intent(in) :: name
      logical, intent(in) :: ok
      real(dp), intent(in), optional :: tol
      character(len=*), intent(in), optional :: info
      ! internal
      character(len=*), parameter :: esc   = achar(27)
      character(len=*), parameter :: green = esc//'[32m'
      character(len=*), parameter :: red   = esc//'[31m'
      character(len=*), parameter :: reset = esc//'[0m'
      character(len=*), parameter :: pfx = 'NEKLAB_CHECK '
      character(len=*), parameter :: p   = green//'PASSED'//reset
      character(len=*), parameter :: f   = red//'FAILED'//reset
      character(len=512) :: msg
      character(len=50) :: ntr
      ntr = padr(trim(name),50)
      call nek_log_message('')
      call nek_log_message('#####################################################', procedure='main')
      call nek_log_message('#     test '//trim(name),                               procedure='main')
      call nek_log_message('#####################################################', procedure='main')
      call nek_log_message('')
      if (ok) then
         if (present(tol)) then
            write(msg, '(A,A50,A,4X,A,ES9.2)')      pfx, ntr, p, 'tol = ', tol
         else
            write(msg, '(A,A50,A)')                 pfx, ntr, p
         end if
      else if (present(info)) then
         if (present(tol)) then
            write(msg, '(A,A50,A,4X,A,ES9.2,1X,A)') pfx, ntr, f, 'tol = ', tol, trim(info)
         else
            write(msg, '(A,A50,A,4X,A)')            pfx, ntr, f, trim(info)
         end if
      else
         if (present(tol)) then
            write(msg, '(A,A50,A,4X,A,ES9.2)')      pfx, ntr, f, 'tol = ', tol
         else
            write(msg, '(A,A50,A)')                 pfx, ntr, f
         end if
      end if
      call nek_log_message(msg, procedure='main')
      call nek_log_message('')
      end subroutine check

      subroutine report(key, value)
      use stdlib_strings, only : padr
      character(len=*), intent(in) :: key
      real(dp), intent(in) :: value
      character(len=512) :: msg
      write(msg, '(A,A40,2X,ES15.5)') 'NEKLAB_RESULT ', padr(trim(key), 40), value
      call nek_log_message(msg, procedure='main')
      end subroutine report

      subroutine check_linop(name, ok, maxerr, with_adjoint, tol, a_tol)
c     verify_linop_axioms result + the largest error of each axiom
      character(len=*), intent(in) :: name
      logical, intent(in) :: ok
      real(dp), intent(in) :: maxerr(4)
      logical, intent(in) :: with_adjoint
      real(dp), intent(in) :: tol
      real(dp), intent(in) :: a_tol
      character(len=128) :: msg
      call report(trim(name)//'.max_err_additivity ', maxerr(1))
      call report(trim(name)//'.max_err_homogeneity', maxerr(2))
      call report(trim(name)//'.max_err_zero_map   ', maxerr(3))
      write(msg, '(A,ES9.2,A,ES9.2)') 'max error ', maxval(maxerr(1:3)),' > lin_tol ', tol
      call check(trim(name)//'.linearity', all(maxerr(1:3) <= lin_tol), tol=tol, info=msg)
      if (with_adjoint) then
         call report(trim(name)//'.max_err_adjoint',     maxerr(4))
         write(msg, '(A,ES9.2,A,ES9.2)') 'error ', maxerr(4), ' > adj_tol ', a_tol
         call nek_log_message(msg, procedure='main')
         call check(trim(name)//'.adjoint', maxerr(4) <= a_tol, tol=a_tol, info=msg)
      end if
      call check('GLOBALLY:'//name, ok, tol=lin_tol)
      call nek_log_message('')
      end subroutine check_linop

      subroutine check_taylor(name, orders)
c     Taylor test: pass if at least half of the observed orders reach
c     taylor_min_order (the smallest steps may level off at the solver
c     tolerance).
      character(len=*), intent(in) :: name
      real(dp), intent(in) :: orders(:)
      character(len=128) :: key, msg
      integer :: k, ngood
      call nek_log_message('')
      do k = 1, size(orders)
         write(key, '(2A,I0)') trim(name), '.order_', k
         call report(key, orders(k))
      end do
      ngood = count(orders >= taylor_min_order)
      write(msg, '(I0,A,I0,A,F4.2)') ngood, ' of ', size(orders), ' orders >= ', taylor_min_order
      call check(name, size(orders) > 0 .and. 2*ngood >= size(orders), info=msg)
      call nek_log_message('')
      end subroutine check_taylor

      end
c----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux=1.0d0
         uy=0.0d0
         uz=0.0d0
         temp=0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp=0.0d0

      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff = 0.0d0
      utrans = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine userq (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use LightKrylov_Logger
      include 'SIZE'
      include 'TOTAL'
      integer iel,ifc
      
      !this mesh was generatd with genbox
      !with only BCs for velicity
      !here we chenge outflow to dirichlet if adjoint
      !and initilize BCs for scalar field

      if(uparam(1)==3.2)then !if adjoint, change BCs
      do iel=1,nelt
      do ifc = 1, 2*ndim
        if(cbc(ifc,iel,1).eq.'O  ')cbc(ifc,iel,1)='v  '
      enddo
      enddo
      endif

      if(ifheat)then
      cbc(:,:,2)=cbc(:,:,1)
      do iel=1,nelt
       do ifc = 1, 2*ndim
        if(cbc(ifc,iel,1).eq.'W  ')cbc(ifc,iel,2)='t  '
        if(cbc(ifc,iel,1).eq.'v  ')cbc(ifc,iel,2)='t  '
      enddo
      enddo
      endif

      call logger_setup(nio=0, log_level=lk_information_level, log_stdout=.true., 
     &                  log_timestamp=.true.)

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
