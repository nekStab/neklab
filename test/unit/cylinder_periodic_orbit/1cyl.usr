c-----------------------------------------------------------------------
c     UNIT TEST -- 2D cylinder, periodic orbit
c
c     nek_ext_dvector, nek_upo_system + nek_upo_jacobian, on the unsteady
c     snapshot.fld with a guessed period.
c
c     The state is not on a periodic orbit, so jac_adjoint_map is only
c     approximately the transpose of jac_direct_map (its bordering terms
c     use f(X(T)) and f(X(0)) the other way round). With the short period
c     X(T) ~ X(0) and the adjoint check passes within adj_tol.
c
c     Settings: the initialised variables at the top of userchk. The test
c     harness (suites/unit/cylinder.py) edits them in its scratch copy.
c-----------------------------------------------------------------------
      include 'neklab_test_helpers.f'
c-----------------------------------------------------------------------
      subroutine userchk
      use LightKrylov
      use neklab
      use neklab_test_helpers
      implicit none
      include 'SIZE'
      include 'TOTAL'

c     ---- Settings -----------------------------------------------------
      character(len=128) :: snapshot = 'snapshot.fld'
      real(dp) :: period           = 0.1_dp     ! guessed period
      logical  :: test_zero_map    = .true.     ! test zero invariant map
      logical  :: test_adjoint     = .true.     ! test adjoint compatibility
      logical  :: verb             = .true.     ! verbose output
      real(dp) :: cfl_limit        = 0.4_dp
      real(dp) :: p2v_factor       = 0.01_dp    ! vtol = ptol*p2v_factor
      integer  :: ntrials_vec      = 10         ! vector axioms (cheap)
      integer  :: ntrials_lin      = 2          ! operator axioms (time integrations)
      real(dp) :: vec_tol          = 1.0e-11_dp ! vector axioms
      real(dp) :: lin_tol          = 1.0e-06_dp ! operator axioms
      real(dp) :: adj_tol          = 1.0e-2_dp  ! operator axioms
      real(dp) :: eps0             = 1.0_dp     ! initial perturbation for Taylor test
      real(dp) :: taylor_tol       = 1.0e-8_dp  ! solver atol in the Taylor test
      real(dp) :: taylor_min_order = 1.8_dp
c     -------------------------------------------------------------------

      type(nek_ext_dvector), allocatable :: evec, x0
      type(nek_upo_system),  allocatable :: sys_upo
      real(dp), allocatable :: orders(:)
      real(dp) :: maxerr(4)
      logical  :: ok
      character(len=128) :: this_test

c     ---- what this run uses, in the log
      call log_section('unit test settings (cylinder_periodic_orbit)')
      call log_setting('snapshot', snapshot)
      call log_setting('period', period)
      call log_setting('test_zero_map', test_zero_map)
      call log_setting('test_adjoint', test_adjoint)
      call log_setting('verb', verb)
      call log_setting('cfl_limit', cfl_limit)
      call log_setting('p2v_factor', p2v_factor)
      call log_setting('ntrials_vec', ntrials_vec)
      call log_setting('ntrials_lin', ntrials_lin)
      call log_setting('vec_tol', vec_tol)
      call log_setting('lin_tol', lin_tol)
      call log_setting('adj_tol', adj_tol)
      call log_setting('eps0', eps0)
      call log_setting('taylor_tol', taylor_tol)
      call log_setting('taylor_min_order', taylor_min_order)

      allocate(x0, evec)

      ! ---- snapshot + guessed period
      call load_fld(trim(snapshot))
      call nek2ext_vec(x0, vx, vy, vz, pr, t)
      x0%T = period

      ! ---- nek_ext_dvector
      this_test = 'nek_ext_dvector.axioms'
      call evec%zero()
      ok = verify_vector_axioms(evec,
     &                      ntrials          = ntrials_vec,
     &                      tolerance        = vec_tol,
     &                      verbose          = verb)
      call check(this_test, ok)

      ! ---- nek_upo_system
      sys_upo = nek_upo_system()
      sys_upo%jacobian = nek_upo_jacobian()
      sys_upo%jacobian%X = x0
      call sys_upo%init(cfl_limit=cfl_limit, p2v_factor=p2v_factor, newton_tol_factor=0.1_dp)

      this_test = 'nek_upo_system.linearization'
      call verify_system_linearization(sys_upo,
     &                      nsteps           = 6,
     &                      eps0             = eps0,
     &                      stepratio        = sqrt(0.1_dp),
     &                      tolerance        = taylor_tol,
     &                      verbose          = verb,
     &                      orders           = orders)
      call check_taylor(this_test, orders, taylor_min_order)

      this_test = 'nek_upo_system%jacobian.axioms'
      ok = verify_linop_axioms(sys_upo%jacobian, x0,
     &                      ntrials          = ntrials_lin,
     &                      tolerance        = lin_tol,
     &                      adj_tolerance    = adj_tol,
     &                      test_zero_map    = test_zero_map,
     &                      test_adjoint     = test_adjoint,
     &                      verbose          = verb,
     &                      stop_on_failure  = .false.,
     &                      max_errors       = maxerr)
      call check_linop(this_test, ok, maxerr, test_adjoint, lin_tol,
     &                 adj_tol)

      call tests_completed()
      end
c----------------------------------------------------------------------
      subroutine userf (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ffx = 0.0d0
      ffy = 0.0d0
      ffz = 0.0d0

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux=1.0d0
         uy=0.0d0
         uz=0.0d0
         temp=0.0d0
      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e

      if (JP.eq.0) then         ! velocity
         e  = gllel(ieg)
         ux = 1.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp=0.0d0

      else                      ! perturbation
         ux = 0.0d0
         uy = 0.0d0
         uz = 0.0d0
         temp = 0.0d0
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff = 0.0d0
      utrans = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine userq (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0d0
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      use LightKrylov_Logger
      include 'SIZE'
      include 'TOTAL'
      integer iel,ifc

      call logger_setup(nio=0, log_level=lk_information_level, log_stdout=.true., log_timestamp=.true.)

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
